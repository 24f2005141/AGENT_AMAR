<?xml version="1.0" encoding="utf-8"?>
<!-- FOCUS NOW — the single item worth interrupting for. Glanceable: one
     header, one instruction, one deadline line, two actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/widget_brand"
            android:textColor="#F0F4F8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/focus_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_focus_now"
            android:textColor="#E8C170"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <TextView
        android:id="@+id/focus_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#F0F4F8"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/focus_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#8FA3B8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/focus_deadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FF8A65"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/focus_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/focus_view_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/widget_button"
            android:text="@string/widget_view"
            android:textColor="#F0F4F8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/focus_done_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/widget_button_primary"
            android:text="@string/widget_done"
            android:textColor="#0C141B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty state: "You're Sorted." -->
    <LinearLayout
        android:id="@+id/focus_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_empty_title"
            android:textColor="#5CD6A0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/widget_empty_body"
            android:textColor="#8FA3B8"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
