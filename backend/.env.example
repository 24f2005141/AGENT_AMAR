# Copy to `.env` and fill in the Google OAuth values.
# Everything else has a working default.

# development | production. In production the app FAILS TO START unless a valid
# DATA_ENCRYPTION_KEY is set (see the Data security section below).
APP_ENV=development
APP_NAME=AGENT_AMAR

# --- Data security (Phase 14) — encryption at rest ---
# AES-256-GCM encryption of sensitive email content at rest (subject, snippet,
# sender, action/deadline text, reminder note, notification detail, connected
# email). Transparent to agents and API responses.
DATA_ENCRYPTION_ENABLED=true
# 32-byte key, base64url- or hex-encoded. NEVER commit a real key. Generate one:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Required in production. In development a blank key falls back to a built-in
# INSECURE key (loud warning; data is NOT confidential). Rotating this key makes
# existing ciphertext unreadable — see docs/SECURITY.md.
DATA_ENCRYPTION_KEY=

# --- Public backend URL -------------------------------------------------------
# The HTTPS origin the Flutter app AND Google's OAuth redirect reach this backend
# at. In production this is a dedicated Cloudflare Tunnel hostname for FastAPI;
# in LAN dev it's the PC's address. It is used to DERIVE GOOGLE_REDIRECT_URI (and
# nothing else). It is SEPARATE from OLLAMA_BASE_URL — never point one at the
# other. Do not commit a real tunnel hostname; it lives in .env only.
#   LAN dev:  http://192.168.1.10:8000
#   Tunnel:   https://<your-fastapi-tunnel-domain>
API_PUBLIC_BASE_URL=

# --- Google OAuth 2.0 (Gmail, read-only) ---
# Create these in the Google Cloud console (see backend/README.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The browser is redirected here after consent. LEAVE BLANK to derive it as
#   {API_PUBLIC_BASE_URL}/api/v1/auth/google/callback
# (or http://localhost:8000/... when API_PUBLIC_BASE_URL is also blank). Set it
# only to override the derivation. Whatever the effective value is, it MUST
# EXACTLY match an "Authorized redirect URI" on the OAuth client, and — for a
# consent screen running on a phone/tablet — Google requires https:// for any
# non-localhost host (expose FastAPI via an HTTPS tunnel). See
# docs/OAUTH_TUNNEL_TESTING.md.
GOOGLE_REDIRECT_URI=

# Legacy file-based token store (dev fallback only — Phase 15 stores each user's
# Gmail credentials encrypted in the `oauth_credentials` table). Keep out of VCS.
GOOGLE_TOKEN_STORAGE_PATH=.tokens

# --- Multi-user auth (Phase 15) ---
# How long a Flutter application session (bearer token) stays valid.
SESSION_TTL_DAYS=30

# --- Browser -> app auth handoff (Phase 17) ---
# After Google sign-in the browser callback 302-redirects HERE so the Flutter app
# returns automatically (no manual browser close, no polling). The URL carries
# only a short-lived, single-use handoff CODE — never a session or Gmail token;
# the app swaps it at POST /api/v1/auth/session/exchange.
#   Custom scheme (now):  agentamar://auth/callback
#   Future HTTPS App Link: https://app.<your-domain>/auth/callback   (also update
#                          the Flutter AUTH_APP_LINK_ORIGIN dart-define + the
#                          Android intent-filter)
APP_AUTH_CALLBACK_URL=agentamar://auth/callback
# How long a handoff code is valid before the app must exchange it (seconds, min 30).
AUTH_HANDOFF_TTL_SECONDS=120

# --- Push notifications / Firebase Cloud Messaging (Phase 16) ---
# Backend-initiated push so a user is notified even when the app is closed.
# Leave unconfigured for local dev — the pipeline still runs, push is just skipped.
PUSH_ENABLED=true
FIREBASE_PROJECT_ID=
# Provide ONE of the following (never commit the real value):
#   a path to the service-account JSON on the server …
FIREBASE_CREDENTIALS_FILE=
#   … OR the JSON contents themselves (e.g. from a secret manager).
FIREBASE_CREDENTIALS_JSON=
# Skip pushing notifications older than this (avoids a flood on first deploy).
PUSH_MAX_AGE_MINUTES=120

# --- Mail Intake Agent (Slice 1) ---
# Timezone used to render ISO 8601 timestamps in the normalized email.
DEFAULT_TIMEZONE=Asia/Kolkata
# ID convention from 04-Schemas/Email Schema.md
GMAIL_ID_PREFIX=gmail_
GMAIL_THREAD_ID_PREFIX=gmail_thread_
GMAIL_USER_ID=me

# --- Triage Agent (Phase 3) ---
# Below this final confidence -> needs_human_review.
TRIAGE_REVIEW_THRESHOLD=0.55
# Deterministic confidence below this -> escalate to the LLM (if configured).
TRIAGE_LLM_THRESHOLD=0.70

# --- Action Agent (Phase 5) ---
ACTION_REVIEW_THRESHOLD=0.55
ACTION_LLM_THRESHOLD=0.65

# --- Deadline Agent (Phase 6) ---
DEADLINE_REVIEW_THRESHOLD=0.55
DEADLINE_LLM_THRESHOLD=0.60
# Reading of an ambiguous all-numeric date (05/09/2026): DMY (India/EU) or MDY (US).
DEADLINE_DATE_LOCALE=DMY

# --- Priority Agent (Phase 7) ---
# Proximity points x this when the deadline is ambiguous but still has a datetime.
PRIORITY_AMBIGUOUS_DEADLINE_FACTOR=0.7
# Hard cap on the optional LLM contextual nudge (Priority Rules §3: -10..+10).
PRIORITY_LLM_MAX_ADJUSTMENT=10

# --- Persistence (Phase 9) ---
# SQLite dev default (file lives in backend/). Use postgresql://user:pass@host/db later.
DATABASE_URL=sqlite:///./agent_amar.db
DATABASE_ECHO=false

# --- Background scheduler (Phase 11B.1) ---
# In-process asyncio scheduler; starts/stops with the app. Set false to run the
# monitor only via POST /api/v1/monitor/deadlines/check.
SCHEDULER_ENABLED=true
DEADLINE_CHECK_INTERVAL_SECONDS=60
REMINDER_CHECK_INTERVAL_SECONDS=60

# --- Incremental Gmail sync (Phase 12) ---
# First connect records a baseline (current mailbox historyId); the historical
# unread inbox is NOT ingested. Later cycles process only new messages via the
# Gmail History API. State persists in gmail_sync_state (survives restart).
#
# The background scheduler runs this AUTOMATICALLY for every connected user every
# GMAIL_SYNC_INTERVAL_SECONDS while the backend is up — so new mail is processed
# (ML -> LLM only if needed -> stored -> notification -> FCM push) and appears in
# the app WITHOUT a manual pull-to-refresh. Raise it (e.g. 900 = 15 min) for
# lighter Gmail API usage; lower it for faster delivery. Manual POST
# /api/v1/gmail/sync still works.
GMAIL_SYNC_ENABLED=true
GMAIL_SYNC_INTERVAL_SECONDS=300
GMAIL_SYNC_MAX_MESSAGES=25

# --- Deadline Monitoring + Reminder Escalation (Phase 10) ---
# Quiet hours (local hour, 0..24). Blank timezone -> DEFAULT_TIMEZONE.
QUIET_HOURS_START=23
QUIET_HOURS_END=7
QUIET_HOURS_TIMEZONE=
# An ALARM may break quiet hours, but only for a CRITICAL deadline.
ALARM_BREAKS_QUIET_HOURS_FOR_CRITICAL=true
# Post-deadline grace before monitoring stops (hours).
DEADLINE_PASSED_GRACE_HOURS=24
# Reject a user-scheduled reminder further out than this (days).
REMINDER_MAX_HORIZON_DAYS=365

# --- Local ML pre-classifier (hybrid triage) ---
# A CPU-only scikit-learn model (TF-IDF + LogisticRegression) that runs between
# the deterministic rules and the LLM. When deterministic confidence is low but
# the local model is confident (and agrees with strong deterministic signals),
# its answer is used and the LLM call is skipped. Optional: with no trained
# model the triage agent behaves exactly as before.
#   Train:  python -m app.ml.train --sample      (bundled starter dataset)
#           python -m app.ml.train               (your data/training/email_training_data.jsonl)
ML_CLASSIFIER_ENABLED=true
# Use the local model only when its top-class probability is at least this.
ML_CLASSIFIER_THRESHOLD=0.85
# Relative paths resolve against the backend directory.
ML_CLASSIFIER_MODEL_PATH=data/models/email_classifier.joblib

# --- TypeSafe Jev shared decision layer (optional) ---
# One batched typed decision request is used only when local agents are unsure.
# Runtime default. The Flutter app can switch conventional / jev / laya and the
# backend persists that choice in AI_MODE_STATE_PATH.
DECISION_PROVIDER=none
# Jev is served through OpenRouter's Decisions API. OPENROUTER_API_KEY is
# preferred; TYPESAFE_API_KEY remains accepted for older local .env files.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_ENDPOINT_URL=https://openrouter.ai/api/alpha/decisions
JEV_TIMEOUT_SECONDS=30
JEV_CHOICE_CONFIDENCE_THRESHOLD=0.85
JEV_NOUL_DECISION_THRESHOLD=0.85
JEV_CACHE_SIZE=512
JEV_MAX_STATE_CHARS=6000
LAYA_MODEL_ID=convaiinnovations/laya
LAYA_MODEL_SUBFOLDER=typed-decisions
LAYA_DEVICE=cpu
AI_MODE_STATE_PATH=data/ai_mode.json

# --- LLM (optional; the agents work deterministically without it) ---
# LLM_PROVIDER: none | openai | anthropic | gemini | groq | ollama
#   none      → deterministic only (no key, no model)
#   openai    → LLM_API_KEY required   (LLM_MODEL default: gpt-4o-mini)
#   anthropic → LLM_API_KEY required   (LLM_MODEL default: claude-sonnet-5)
#   gemini    → LLM_API_KEY required   (LLM_MODEL default: gemini-3.5-flash-lite)
#   groq      → LLM_API_KEY required   (LLM_MODEL default: openai/gpt-oss-20b)
#   ollama    → no key; LLM_MODEL required + OLLAMA_BASE_URL
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Optional automatic failover. Recommended free-tier pairing:
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_API_KEY=
LLM_MAX_TOKENS=512
# Per-request timeout for a normal (classification) LLM call. Raise it for a
# slow local model — a small quantised model on CPU can take 20-40s.
LLM_TIMEOUT_SECONDS=45
# Longer ceiling for AI reply drafting only (3 options = a bigger generation).
# <= 0 falls back to LLM_TIMEOUT_SECONDS. Keeps a slow model off the 503 path.
LLM_REPLY_TIMEOUT_SECONDS=120
# Ollama server base URL (used only when LLM_PROVIDER=ollama). The OllamaLLMClient
# talks to {OLLAMA_BASE_URL}/api/generate — a trailing slash is fine, it's
# stripped. Point it at whichever is reachable; no code change either way:
#   LAN:            http://192.168.1.11:11434
#   HTTPS tunnel:   https://ollama.example.com   (e.g. Cloudflare Tunnel → Ubuntu box)
# Flutter never talks to Ollama — only this backend does, via the LLM abstraction.
# This is a DIFFERENT tunnel/host from API_PUBLIC_BASE_URL — keep them distinct.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# =============================================================================
# PRODUCTION HARDENING
# =============================================================================
# These have safe development defaults; the values below are what a PRODUCTION
# deployment sets. `APP_ENV=production` makes the app validate the whole config
# at startup and refuse to boot if something required is missing or unsafe
# (see app/core/config.py::validate_production_config).

# --- Concurrency on the private LLM box ---
# The Ollama host is a single limited machine: two concurrent generations swap
# and time out rather than going faster. Requests queue for a free slot and,
# if none frees in time, fall back to the local ML classification.
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_QUEUE_TIMEOUT_SECONDS=30

# --- Debug surface ---
# Registers the UNAUTHENTICATED POST /intake/gmail helper. Development only —
# production refuses to start when this is true.
ENABLE_DEBUG_INTAKE_ENDPOINT=false

# --- HTTP hardening ---
# Comma-separated Host allowlist, e.g. "api.example.com". Empty = accept any
# Host (fine only when a single trusted reverse proxy sits in front).
ALLOWED_HOSTS=
# Comma-separated browser origins. Leave EMPTY for the mobile app: native
# clients send no Origin header, so no CORS headers should be emitted. Never "*".
CORS_ALLOW_ORIGINS=
# Per-session limits for the expensive endpoints (LLM reply drafting, sync).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LLM_PER_MINUTE=6
RATE_LIMIT_SYNC_PER_MINUTE=12

# =============================================================================
# PRODUCTION VALUES (placeholders — never commit real secrets)
# =============================================================================
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://sorted:<password>@db:5432/sorted
# API_PUBLIC_BASE_URL=https://api.<your-domain>
# GOOGLE_CLIENT_ID=<from Google Cloud Console>
# GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
# DATA_ENCRYPTION_KEY=<python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())">
# FIREBASE_CREDENTIALS_JSON=<service-account JSON, single line>
# OLLAMA_BASE_URL=http://<private-host-or-tailscale-name>:11434
# ALLOWED_HOSTS=api.<your-domain>
#
# Per-process role (docker-compose sets these):
#   API containers    -> SCHEDULER_ENABLED=false
#   Worker container  -> SCHEDULER_ENABLED=true   (exactly ONE instance)
